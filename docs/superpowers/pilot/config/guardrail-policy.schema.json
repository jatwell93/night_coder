{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://night-coder.local/config/guardrail-policy.schema.json",
  "title": "GuardrailPolicyConfig",
  "type": "object",
  "required": [
    "policy_id",
    "version",
    "mode",
    "applies_to_profile",
    "blocked_patterns",
    "allowed_patterns"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "const": "block_allow_only"
    },
    "applies_to_profile": {
      "type": "string",
      "enum": ["offline", "online", "both"]
    },
    "blocked_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
